DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=django-insecure-dev-key-not-for-production-use
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
JWT_SECRET_KEY=jwt-secret-key-for-development-only
OTP_SECRET_KEY=otp-secret-key-for-development-only
ENCRYPTION_KEY=encryption-key-for-development-only
LOG_LEVEL=DEBUG
