# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zic_db
DATABASE_NAME=zic_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security
JWT_SECRET_KEY=change-this-jwt-secret
OTP_SECRET_KEY=change-this-otp-secret
ENCRYPTION_KEY=change-this-encryption-key
OAUTH2_CLIENT_ID=your-client-id
OAUTH2_CLIENT_SECRET=your-client-secret

# Email
EMAIL_HOST=smtp.zic.co.zw
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@zic.co.zw
EMAIL_HOST_PASSWORD=change-this
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@zic.co.zw

# SMS (Africa's Talking)
AT_API_KEY=your-api-key
AT_USERNAME=your-username
AT_SENDER_ID=ZIC

# Features
ENABLE_2FA=True
ENABLE_OAUTH=True
ENABLE_SMS_OTP=False

# AI
DEEPSEEK_API_KEY=

# Sentry
SENTRY_DSN=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=DEBUG
LOG_DIR=logs/
